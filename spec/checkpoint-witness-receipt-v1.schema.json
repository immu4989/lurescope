{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurescope/spec/checkpoint-witness-receipt/v1",
  "title": "LureScope offline checkpoint witness receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "witness", "statement", "dsse", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurescope/spec/checkpoint-witness-receipt/v1"}, "schema_version": {"const": 1},
    "witness": {"type": "object", "additionalProperties": false, "required": ["witness_id", "key_id"], "properties": {"witness_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/-]{0,199}$"}, "key_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "statement": {"type": "object", "additionalProperties": false, "required": ["_type", "subject", "predicateType", "predicate"], "properties": {"_type": {"const": "https://in-toto.io/Statement/v1"}, "subject": {"type": "array", "minItems": 1, "maxItems": 1}, "predicateType": {"const": "https://github.com/immu4989/lurescope/spec/checkpoint-witness/v1"}, "predicate": {"type": "object"}}},
    "dsse": {"type": "object", "additionalProperties": false, "required": ["payloadType", "payload", "signatures"], "properties": {"payloadType": {"const": "application/vnd.in-toto+json"}, "payload": {"type": "string", "contentEncoding": "base64"}, "signatures": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["keyid", "sig"], "properties": {"keyid": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "sig": {"type": "string", "contentEncoding": "base64"}}}}}},
    "limitations": {"const": ["receipt_proves_observation_by_a_key_not_log_inclusion_or_organization_identity", "witness_independence_key_custody_and_timestamp_accuracy_require_external_governance", "offline_receipt_is_scitt_aligned_but_not_an_rfc9943_transparency_service_receipt", "checkpoint_integrity_is_not_proof_of_containment_revocation_enforcement_compliance_or_authorization"]}
  }
}
