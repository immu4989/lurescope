{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurescope/spec/invariant-evidence-checkpoint/v1",
  "title": "LureScope LureInvariant evidence in-toto checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/manifest_subject"},
        {"$ref": "#/$defs/plan_subject"},
        {"$ref": "#/$defs/observations_subject"},
        {"$ref": "#/$defs/evaluation_subject"}
      ],
      "items": false
    },
    "predicateType": {
      "const": "https://github.com/immu4989/lurescope/spec/invariant-evidence-checkpoint/v1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "created_at",
        "system_id",
        "overall_status",
        "authentication_mode",
        "limitations",
        "interpretation_boundary"
      ],
      "properties": {
        "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/-]{0,199}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "system_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 96},
        "overall_status": {"enum": ["pass", "fail", "insufficient_evidence"]},
        "authentication_mode": {"enum": ["unsigned", "ecdsa-p256-dsse"]},
        "limitations": {
          "const": [
            "source_semantics_are_recomputed_but_source_collection_is_not_replayed",
            "signed_evidence_authenticates_a_key_not_an_organization_without_external_trust",
            "bundle_integrity_does_not_establish_inventory_or_telemetry_completeness",
            "passing_is_not_proof_of_containment_safety_compliance_certification_or_authorization"
          ]
        },
        "interpretation_boundary": {
          "const": "This bundle proves the internal consistency and exact byte bindings of declared graph and temporal evidence. A pass means violations were not observed within the declared, complete evidence boundary; it is not proof of universal unreachability, containment, or safety."
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digest_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {"sha256": {"$ref": "#/$defs/digest"}}
    },
    "manifest_subject": {"$ref": "#/$defs/subject", "properties": {"name": {"const": "bundle.json"}}},
    "plan_subject": {"$ref": "#/$defs/subject", "properties": {"name": {"const": "evidence/plan.json"}}},
    "observations_subject": {"$ref": "#/$defs/subject", "properties": {"name": {"const": "evidence/observations.json"}}},
    "evaluation_subject": {"$ref": "#/$defs/subject", "properties": {"name": {"const": "evidence/evaluation.json"}}},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string"},
        "digest": {"$ref": "#/$defs/digest_object"}
      }
    }
  }
}
