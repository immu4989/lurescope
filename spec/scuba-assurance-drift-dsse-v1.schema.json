{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurescope/spec/scuba-assurance-drift-dsse/v1",
  "title": "LureScope SCuBA Assurance Drift DSSE Envelope v1",
  "description": "DSSE envelope carrying exact SCuBA Assurance Drift in-toto Statement bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": {"const": "application/vnd.in-toto+json"},
    "payload": {"type": "string", "contentEncoding": "base64"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sig": {"type": "string", "contentEncoding": "base64"}
        }
      }
    }
  }
}
