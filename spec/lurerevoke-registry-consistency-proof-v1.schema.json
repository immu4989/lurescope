{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurescope/spec/lurerevoke-registry-consistency-proof/v1",
  "title": "Portable authenticated LureRevoke registry consistency proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "registry_config",
    "first_tree_size",
    "first_root_sha256",
    "second_tree_size",
    "second_root_sha256",
    "consistency_path_sha256",
    "first_tree_head_statement",
    "first_tree_head_dsse",
    "second_tree_head_statement",
    "second_tree_head_dsse",
    "limitations",
    "interpretation_boundary"
  ],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurescope/spec/lurerevoke-registry-consistency-proof/v1"},
    "schema_version": {"const": 1},
    "registry_config": {"$ref": "#/$defs/config"},
    "first_tree_size": {"type": "integer", "minimum": 1, "maximum": 10000},
    "first_root_sha256": {"$ref": "#/$defs/digest"},
    "second_tree_size": {"type": "integer", "minimum": 2, "maximum": 10000},
    "second_root_sha256": {"$ref": "#/$defs/digest"},
    "consistency_path_sha256": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/digest"}
    },
    "first_tree_head_statement": {"$ref": "#/$defs/tree_head"},
    "first_tree_head_dsse": {"$ref": "#/$defs/dsse"},
    "second_tree_head_statement": {"$ref": "#/$defs/tree_head"},
    "second_tree_head_dsse": {"$ref": "#/$defs/dsse"},
    "limitations": {"$ref": "#/$defs/proof_limitations"},
    "interpretation_boundary": {"$ref": "#/$defs/proof_interpretation"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "portable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/-]{0,199}$"
    },
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "registry_limitations": {
      "const": [
        "registry_contains_checkpoint_digests_status_time_and_receiver_version_metadata_only",
        "signed_tree_heads_detect_mutation_deletion_or_reordering_within_the_available_history",
        "tail_deletion_requires_a_previously_retained_or_independently_witnessed_tree_head",
        "registration_does_not_prove_event_observation_receiver_clock_or_enforcement_authenticity",
        "registry_is_not_an_rfc9943_transparency_service_rfc9942_vds_or_compliance_claim"
      ]
    },
    "registry_interpretation": {
      "const": "A valid registry proves that its available registration records form the ordered Merkle history committed by each authenticated tree head. A separately retained tree head can detect rollback. Registration does not prove the underlying revocation evidence is complete, deployed, or authentic beyond its bundle key."
    },
    "proof_limitations": {
      "const": [
        "proof_authenticates_that_one_signed_tree_head_is_a_prefix_of_another",
        "proof_discloses_merkle_nodes_and_signed_heads_but_no_registry_entries_or_evaluations",
        "proof_does_not_establish_global_non_equivocation_across_uncompared_tree_heads",
        "proof_does_not_prove_event_observation_receiver_clock_or_enforcement_authenticity",
        "proof_is_not_an_rfc9943_receipt_rfc9942_vds_or_compliance_claim"
      ]
    },
    "proof_interpretation": {
      "const": "A valid proof establishes that the entry sequence committed by the first authenticated tree head is an exact prefix of the sequence committed by the second authenticated tree head. It does not rule out a conflicting head that was not compared or prove the truth and completeness of underlying revocation observations."
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "registry_id", "created_at", "producer", "registration_policy", "hash_profile", "signer_key_id", "limitations", "interpretation_boundary"],
      "properties": {
        "schema": {"const": "https://github.com/immu4989/lurescope/spec/lurerevoke-registry/v1"},
        "schema_version": {"const": 1},
        "registry_id": {"$ref": "#/$defs/portable_id"},
        "created_at": {"type": "string", "format": "date-time"},
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "lurescope"},
            "version": {"$ref": "#/$defs/id"}
          }
        },
        "registration_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system_id", "environment", "receiver_name", "require_authenticated_bundle"],
          "properties": {
            "system_id": {"$ref": "#/$defs/id"},
            "environment": {"enum": ["development", "evaluation", "staging", "production"]},
            "receiver_name": {"$ref": "#/$defs/id"},
            "require_authenticated_bundle": {"const": true}
          }
        },
        "hash_profile": {"const": "rfc9162-sha256-merkle-tree"},
        "signer_key_id": {"$ref": "#/$defs/digest"},
        "limitations": {"$ref": "#/$defs/registry_limitations"},
        "interpretation_boundary": {"$ref": "#/$defs/registry_interpretation"}
      }
    },
    "tree_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["_type", "subject", "predicateType", "predicate"],
      "properties": {
        "_type": {"const": "https://in-toto.io/Statement/v1"},
        "subject": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "digest"],
            "properties": {
              "name": {"const": "entry.json"},
              "digest": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sha256"],
                "properties": {"sha256": {"$ref": "#/$defs/digest"}}
              }
            }
          }
        },
        "predicateType": {"const": "https://github.com/immu4989/lurescope/spec/lurerevoke-registry-tree-head/v1"},
        "predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry_id", "tree_size", "root_sha256", "latest_entry_sha256", "previous_tree_head_sha256", "config_sha256", "registered_at", "hash_profile", "signer_key_id", "limitations", "interpretation_boundary"],
          "properties": {
            "registry_id": {"$ref": "#/$defs/portable_id"},
            "tree_size": {"type": "integer", "minimum": 1, "maximum": 10000},
            "root_sha256": {"$ref": "#/$defs/digest"},
            "latest_entry_sha256": {"$ref": "#/$defs/digest"},
            "previous_tree_head_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
            "config_sha256": {"$ref": "#/$defs/digest"},
            "registered_at": {"type": "string", "format": "date-time"},
            "hash_profile": {"const": "rfc9162-sha256-merkle-tree"},
            "signer_key_id": {"$ref": "#/$defs/digest"},
            "limitations": {"$ref": "#/$defs/registry_limitations"},
            "interpretation_boundary": {"$ref": "#/$defs/registry_interpretation"}
          }
        }
      }
    },
    "dsse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadType", "payload", "signatures"],
      "properties": {
        "payloadType": {"const": "application/vnd.in-toto+json"},
        "payload": {"type": "string", "contentEncoding": "base64", "minLength": 4},
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keyid", "sig"],
            "properties": {
              "keyid": {"$ref": "#/$defs/digest"},
              "sig": {"type": "string", "contentEncoding": "base64", "minLength": 8}
            }
          }
        }
      }
    }
  }
}
