{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurescope/spec/shadow-run/v1",
  "title": "LureScope Shadow Inbox run v1",
  "type": "object",
  "required": [
    "schema", "schema_version", "generated_at", "candidate_count", "unique_count",
    "duplicate_count", "source_type_counts", "unique_source_type_counts", "manifest",
    "labels", "report_json", "report_markdown"
  ],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurescope/spec/shadow-run/v1"},
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "unique_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "duplicate_count": {"type": "integer", "minimum": 0, "maximum": 999},
    "source_type_counts": {"$ref": "#/$defs/sourceCounts"},
    "unique_source_type_counts": {"$ref": "#/$defs/sourceCounts"},
    "manifest": {"const": "manifest.jsonl"},
    "labels": {"const": "analyst-labels.jsonl"},
    "report_json": {"const": "shadow-report.json"},
    "report_markdown": {"const": "shadow-report.md"}
  },
  "$defs": {
    "sourceCounts": {
      "type": "object",
      "properties": {
        "eml": {"type": "integer", "minimum": 0, "maximum": 1000},
        "maildir": {"type": "integer", "minimum": 0, "maximum": 1000},
        "mbox": {"type": "integer", "minimum": 0, "maximum": 1000}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
