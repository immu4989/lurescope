{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurescope/spec/luremandate-authenticated-verification/v1",
  "title": "Externally pinned DSSE-authenticated LureMandate verification v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "verification_id", "verified_at", "engine", "documents", "public_keys", "approval_envelopes", "producer_evaluation", "checks", "summary", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurescope/spec/luremandate-authenticated-verification/v1"},
    "schema_version": {"const": 1},
    "verification_id": {"$ref": "#/$defs/id"},
    "verified_at": {"type": "string", "format": "date-time"},
    "engine": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "lurescope-luremandate-dsse"}, "version": {"type": "string", "minLength": 1, "maxLength": 32}}},
    "documents": {"type": "object", "additionalProperties": false, "required": ["plan", "run", "evaluation"], "properties": {"plan": {"$ref": "#/$defs/document"}, "run": {"$ref": "#/$defs/document"}, "evaluation": {"$ref": "#/$defs/document"}}},
    "public_keys": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"$ref": "#/$defs/public_key"}},
    "approval_envelopes": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"$ref": "#/$defs/approval_envelope"}},
    "producer_evaluation": {"$ref": "https://github.com/immu4989/lurebench/spec/luremandate-evaluation-v1"},
    "checks": {"const": ["strict_source_json_reparsed", "producer_evaluation_independently_reproduced", "canonical_approval_statement_coverage_complete", "evidence_directory_exact", "externally_supplied_approver_keys_pinned", "distinct_key_per_approver_enforced", "dsse_payload_type_and_shape_rechecked", "canonical_statement_bytes_recomputed", "approval_claims_exactly_bound", "ecdsa_p256_signatures_authenticated"]},
    "summary": {"$ref": "#/$defs/summary"},
    "limitations": {"const": ["external_key_to_person_mapping_is_a_reviewer_input_not_directory_or_identity_proofing", "p256_dsse_authentication_does_not_verify_hardware_backing_kms_lifecycle_revocation_or_timestamp_authority", "authenticated_approval_metadata_does_not_establish_that_the_human_saw_or_understood_hidden_action_content", "effect_observations_and_complete_runtime_mediation_remain_external_claims", "impact_units_roles_thresholds_and_legal_authority_require_organization_specific_governance", "passing_is_not_compliance_certification_safety_or_deployment_authorization"]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 65536},
    "document": {"type": "object", "additionalProperties": false, "required": ["document_sha256", "payload_base64"], "properties": {"document_sha256": {"$ref": "#/$defs/digest"}, "payload_base64": {"type": "string", "minLength": 4, "maxLength": 11184812, "pattern": "^[A-Za-z0-9+/]*={0,2}$"}}},
    "public_key": {"type": "object", "additionalProperties": false, "required": ["approver_id", "public_key_sha256", "pem_sha256", "pem_base64"], "properties": {"approver_id": {"$ref": "#/$defs/id"}, "public_key_sha256": {"$ref": "#/$defs/digest"}, "pem_sha256": {"$ref": "#/$defs/digest"}, "pem_base64": {"type": "string", "minLength": 4, "maxLength": 87384, "pattern": "^[A-Za-z0-9+/]*={0,2}$"}}},
    "approval_envelope": {"type": "object", "additionalProperties": false, "required": ["approval_id", "approver_id", "public_key_sha256", "statement_sha256", "envelope_sha256", "envelope_base64"], "properties": {"approval_id": {"$ref": "#/$defs/id"}, "approver_id": {"$ref": "#/$defs/id"}, "public_key_sha256": {"$ref": "#/$defs/digest"}, "statement_sha256": {"$ref": "#/$defs/digest"}, "envelope_sha256": {"$ref": "#/$defs/digest"}, "envelope_base64": {"type": "string", "minLength": 4, "maxLength": 2796204, "pattern": "^[A-Za-z0-9+/]*={0,2}$"}}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "transaction_count", "passed_transaction_count", "failed_transaction_count", "inconclusive_transaction_count", "expected_allow_count", "correct_allow_count", "expected_block_count", "correct_block_count", "invalid_allow_count", "authority_bypass_count", "collateral_denial_count", "incorrect_reason_count", "unknown_outcome_count", "finding_count", "unique_approval_count", "authenticated_approval_count", "approver_key_count", "source_documents_reparsed", "producer_evaluation_reproduced", "approval_authentication_complete", "distinct_approver_keys", "transaction_authority_evidence_authenticated"],
      "properties": {
        "verdict": {"enum": ["pass", "fail", "inconclusive"]},
        "transaction_count": {"$ref": "#/$defs/count"}, "passed_transaction_count": {"$ref": "#/$defs/count"}, "failed_transaction_count": {"$ref": "#/$defs/count"}, "inconclusive_transaction_count": {"$ref": "#/$defs/count"},
        "expected_allow_count": {"$ref": "#/$defs/count"}, "correct_allow_count": {"$ref": "#/$defs/count"}, "expected_block_count": {"$ref": "#/$defs/count"}, "correct_block_count": {"$ref": "#/$defs/count"},
        "invalid_allow_count": {"$ref": "#/$defs/count"}, "authority_bypass_count": {"$ref": "#/$defs/count"}, "collateral_denial_count": {"$ref": "#/$defs/count"}, "incorrect_reason_count": {"$ref": "#/$defs/count"}, "unknown_outcome_count": {"$ref": "#/$defs/count"}, "finding_count": {"$ref": "#/$defs/count"},
        "unique_approval_count": {"$ref": "#/$defs/count"}, "authenticated_approval_count": {"$ref": "#/$defs/count"}, "approver_key_count": {"$ref": "#/$defs/count"},
        "source_documents_reparsed": {"const": true}, "producer_evaluation_reproduced": {"const": true}, "approval_authentication_complete": {"const": true}, "distinct_approver_keys": {"const": true}, "transaction_authority_evidence_authenticated": {"type": "boolean"}
      }
    }
  }
}
