{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurescope/spec/scuba-assurance-drift-statement/v1",
  "title": "LureScope SCuBA Assurance Drift in-toto Statement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/subject", "properties": {"name": {"const": "before-scuba-evidence.json"}}},
        {"$ref": "#/$defs/subject", "properties": {"name": {"const": "after-scuba-evidence.json"}}},
        {"$ref": "#/$defs/subject", "properties": {"name": {"const": "assurance-drift.json"}}},
        {"$ref": "#/$defs/subject", "properties": {"name": {"const": "assurance-drift.md"}}},
        {"$ref": "#/$defs/subject", "properties": {"name": {"const": "assurance-drift.html"}}},
        {"$ref": "#/$defs/subject", "properties": {"name": {"const": "oscal-assessment-results.json"}}}
      ],
      "items": false
    },
    "predicateType": {
      "const": "https://github.com/immu4989/lurescope/spec/scuba-assurance-drift-statement/v1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "spec_version",
        "generated_at",
        "before_combined_statement_sha256",
        "after_combined_statement_sha256",
        "previous_ledger_statement_sha256",
        "summary",
        "privacy",
        "interpretation_boundary",
        "limitations"
      ],
      "properties": {
        "spec": {"const": "scuba-assurance-drift-ledger"},
        "spec_version": {"const": "1.0"},
        "generated_at": {"type": "string", "format": "date-time"},
        "before_combined_statement_sha256": {"$ref": "#/$defs/sha256"},
        "after_combined_statement_sha256": {"$ref": "#/$defs/sha256"},
        "previous_ledger_statement_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "summary": {"$ref": "#/$defs/summary"},
        "privacy": {
          "const": {
            "minimized": true,
            "shareable_by_default": false,
            "security_posture_sensitive": true,
            "contains_tenant_identifiers": false,
            "contains_raw_provider_settings": false,
            "contains_free_text_details": false,
            "contains_message_content": false,
            "retained_control_fields": ["product", "control_id", "result", "criticality"]
          }
        },
        "interpretation_boundary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 128}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string"},
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256"],
          "properties": {"sha256": {"$ref": "#/$defs/sha256"}}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_control_count", "changed_control_count", "transitions", "candidate_lifecycle"],
      "properties": {
        "total_control_count": {"type": "integer", "minimum": 0, "maximum": 15000},
        "changed_control_count": {"type": "integer", "minimum": 0, "maximum": 15000},
        "transitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "improved", "newly_failing", "non_comparable", "regressed", "removed", "unchanged"],
          "properties": {
            "added": {"type": "integer", "minimum": 0},
            "improved": {"type": "integer", "minimum": 0},
            "newly_failing": {"type": "integer", "minimum": 0},
            "non_comparable": {"type": "integer", "minimum": 0},
            "regressed": {"type": "integer", "minimum": 0},
            "removed": {"type": "integer", "minimum": 0},
            "unchanged": {"type": "integer", "minimum": 0}
          }
        },
        "candidate_lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["new_candidate", "no_longer_observed", "not_candidate", "persistent_candidate"],
          "properties": {
            "new_candidate": {"type": "integer", "minimum": 0},
            "no_longer_observed": {"type": "integer", "minimum": 0},
            "not_candidate": {"type": "integer", "minimum": 0},
            "persistent_candidate": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
