{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurescope/spec/checkpoint-witness-request/v1",
  "title": "LureScope checkpoint witness request v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "request_id", "created_at", "bundle_kind", "plan_sha256", "checkpoint_sequence", "checkpoint_statement_sha256", "status", "nonce", "privacy", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurescope/spec/checkpoint-witness-request/v1"}, "schema_version": {"const": 1}, "request_id": {"$ref": "#/$defs/id"}, "created_at": {"type": "string", "format": "date-time"}, "bundle_kind": {"enum": ["lureboundary", "lurewatch"]}, "plan_sha256": {"$ref": "#/$defs/digest"}, "checkpoint_sequence": {"type": "integer", "minimum": 1}, "checkpoint_statement_sha256": {"$ref": "#/$defs/digest"}, "status": {"enum": ["pass", "breach", "monitoring"]}, "nonce": {"type": "string", "minLength": 8, "maxLength": 200, "pattern": "^[A-Za-z0-9._:@+/-]+$"},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["contains_event_content", "contains_prompts_commands_payloads_credentials_or_reasoning", "checkpoint_digest_only"], "properties": {"contains_event_content": {"const": false}, "contains_prompts_commands_payloads_credentials_or_reasoning": {"const": false}, "checkpoint_digest_only": {"const": true}}},
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/-]{0,199}$"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "limitations": {"const": ["receipt_proves_observation_by_a_key_not_log_inclusion_or_organization_identity", "witness_independence_key_custody_and_timestamp_accuracy_require_external_governance", "offline_receipt_is_scitt_aligned_but_not_an_rfc9943_transparency_service_receipt", "checkpoint_integrity_is_not_proof_of_containment_safety_compliance_or_authorization"]}}
}
