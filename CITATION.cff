cff-version: 1.2.0
title: "LureScope: Adversarial Fraud Triage and Portable Resilience Evidence"
message: "If you use LureScope in your work, please cite it."
type: software
authors:
  - family-names: Ahamed
    given-names: Imran
    email: immu4989@gmail.com
    orcid: "https://orcid.org/0009-0002-7717-7480"
